<p data-start="2209" data-end="2225">👉 Step by step:</p>
<ol data-start="2227" data-end="2316">
<li data-section-id="zf3dgm" data-start="2227" data-end="2251">
<p data-start="2230" data-end="2251">index.js → App load</p>
</li>
<li data-section-id="1wa3yzq" data-start="2252" data-end="2275">
<p data-start="2255" data-end="2275">App → Routes check</p>
</li>
